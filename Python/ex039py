from datetime import datetime
ano_atual = datetime.now().year

ano = int(input("Digite o seu ano de nascimento: "))
if ano_atual - ano < 18:
    print(f"Ainda faltam {18 - (ano_atual - ano)} anos para o alistamento.")
    print(f"Seu alistamento será em {ano + 18}.")
elif ano_atual - ano == 18:
    print(f"Você deve se alistar este ano.")
else:
    print(f"Você já deveria ter se alistado há {ano_atual - ano - 18} anos.")
